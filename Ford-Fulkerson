#include <bits/stdc++.h>
using namespace std;
const int INF = 999999999;
int dfs(int s, int t, int curr,int flow, vector<int>& parent,vector<vector<int>> & capacity, vector<vector<int>> & adj) {
    if (s==curr) {
        fill(parent.begin(),parent.end(),-1);
        parent[s] = -2;
    }
    for (auto node : adj[curr]) {
        if (parent[node] == -1 && capacity[curr][node]) {
            parent[node] = curr;
            int new_flow = min(flow,capacity[curr][node]);
            if (node == t) {
                return new_flow;
            }
            int rez = dfs(s,t,node,new_flow,parent,capacity,adj);
            if (rez > 0) {
                return rez;
            }
        }
    }
    return 0;

}
int maxflow(int s, int t,int n,vector<vector<int>>& capacity,vector<vector<int>>& adj) {
    int flow = 0;
    vector<int> parent(n);
    int new_flow;
    while (new_flow = dfs(s,t,s,INF,parent,capacity,adj)) {
        flow += new_flow;
        int cur = t;
        while (cur != s) {
            int prev = parent[cur];
            capacity[prev][cur] -= new_flow;
            capacity[cur][prev] += new_flow;
            cur = prev;
        }
    }
    return flow;
}
