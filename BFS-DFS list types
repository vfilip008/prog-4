// DFS ADJACENCY LIST


#include <bits/stdc++.h>
using namespace std;
void dfs(int start,vector<vector<int>> &v , vector<bool> &visited){
    visited[start] = true;
    cout<<start<<" ";
    for(int nodes : v[start]){
        if(!visited[nodes]){
            dfs(nodes,v,visited);
        }
    }
}
int main()
{
    vector<vector<int>> v = {{1,2},{0,3},{0,4,5} ,{1,6},{2},{2},{3}};
    vector<bool> visited (v.size(),false);
    dfs(0,v,visited);

    return 0;
}


