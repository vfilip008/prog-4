    v.push_back({4,2});
    v.push_back({5,2});
    v.push_back({6,3});
    vector<bool> visited(7,false);
    dfs(0,v,visited);

    return 0;
}


// BFS ADJACENCY LIST


#include <bits/stdc++.h>
using namespace std;
void bfs(int start,vector<vector<int>> &v , vector<bool> &visited){
    visited[start] = true;
    queue<int> q;
    q.push(start);
    while(!q.empty()) {
        int x = q.front();
        q.pop();
        cout<<x<<" ";
        for (int node : v[x]) {
            if (!visited[node]) {
                visited[node] = true;
                q.push(node);
            }
        }
    }
}
int main()
{
    vector<vector<int>> v = {{1,2},{0,3},{0,4,5} ,{1,6},{2},{2},{3}};
    vector<bool> visited (v.size(),false);
    bfs(0,v,visited);

    return 0;
}


