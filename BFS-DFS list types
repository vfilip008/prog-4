// DFS EDGE LIST


#include <bits/stdc++.h>
using namespace std;
void dfs(int start,vector<pair<int,int>> &v,vector<bool>& visited){
    visited[start] = 1;
    cout<<start<<" ";
    for(int i=0;i<v.size();i++){
        if(v[i].first == start && !visited[v[i].second]){
            dfs(v[i].second,v,visited);
        }
    }
}
int main()
{

    vector<pair<int,int>> v;
